# JWT Secret Key - MUST be loaded from environment, never hardcoded
JWT_SECRET=secure-rag-jwt-secret-key-3842-dev-sample-do-not-share
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini API Key (Injected automatically at runtime by AI Studio)
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Backend Service Port
PORT=8000
